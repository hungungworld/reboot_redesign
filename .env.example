# REBOOT 대시보드 .env 양식 (깃에 올려도 되는 빈 양식)
# 복사해서 .env로 저장한 뒤 값을 채웁니다. .env는 깃에 올리지 않습니다.
# 설명은 줄 끝이 아니라 윗줄에 씁니다 (팀 README 7장).
# API 키는 대시보드 설정 › 연결 화면에서 넣어도 됩니다. 화면 입력이 .env보다 우선입니다.

# 관리자 계정 로그인
DEMO_LOGIN=

#슬랙 SLACK
#리뷰 공유
SLACK_WEBHOOK_URL=

# --- 공통 (공통 담당) ---
# 세션 서명용. 로컬은 비우면 instance/에 개발용 키를 만듦. Render는 자동 생성
SECRET_KEY=
# 화면에서 입력한 API 키 암호화용. 바꾸면 저장된 키를 다시 입력해야 함 (비우면 SECRET_KEY 사용)
APP_SECRET_KEY=
# 처음 실행할 때 계정이 하나도 없으면 이 정보로 관리자 계정을 만듦 (비밀번호 8자 이상)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 업로드·DB·캐시 위치. 비우면 reboot-dashboard/instance (Render는 /var/data)
DATA_DIR=
# 선택 · PostgreSQL을 쓸 때만 (비우면 DATA_DIR/reboot.db SQLite)
DATABASE_URL=
TIMEZONE=Asia/Seoul
# 하루 1회 작업(뉴스·규제 모니터링 수집)을 외부 크론이 부를 때 쓰는 토큰 (X-Cron-Token 헤더)
CRON_TOKEN=

# --- AI ---
# 홈·인사이트·콘텐츠·파트너·성과분석 (예전 이름 open_api · AI_API_KEY도 읽음)
OPENAI_API_KEY=
# 선택 · 비우면 gpt-4o-mini
OPENAI_MODEL=
# 컴플라이언스 AI 2차 판정 · CS 답장 초안 · 모니터링 한글 요약 (비우면 규칙 판정만)
ANTHROPIC_API_KEY=

# --- 홈 · 데일리 브리핑 (강현서) ---
# GDELT 뉴스 수집 요청 간격 (초, 최소 5). GDELT는 키가 필요 없음
GDELT_REQUEST_INTERVAL_SEC=5

# --- 시장·고객 인사이트 (이현경) ---
SERPAPI_KEY=
YOUTUBE_API_KEY=
FIRECRAWL_API_KEY=

# --- 성과분석 ---
# 한국수출입은행 환율 (비우면 1,400원 기본값)
KEXIM_API_KEY=

# --- 컴플라이언스 (소준희) ---
# 선택 · openFDA는 키 없이 먼저 부르고 실패할 때만 사용 (404는 0건)
OPENFDA_API_KEY=
# fda.gov 요청 간격 (초)
CRAWL_DELAY_SECONDS=30
# 최근 며칠 경고장·규칙까지 볼지
REFRESH_LOOKBACK_DAYS=365
# 1회에 읽을 최대 경고장 수
REFRESH_MAX_LETTERS=10
# 무료 키 · Regulations.gov (발급: docs/compliance/README.md 부록 A)
REGULATIONS_GOV_API_KEY=
# 무료 토큰 · CourtListener
COURTLISTENER_TOKEN=

FDA_DASHBOARD_USER=
FDA_DASHBOARD_KEY=

# --- CS (소준희) ---
# 문의로 읽을 메일 조건. 예: to:<본인주소>+cs@gmail.com newer_than:30d
GMAIL_QUERY=
# Google로 로그인 (웹 애플리케이션 OAuth 클라이언트). 승인된 리디렉션 URI:
#   로컬  http://127.0.0.1:5000/api/cs/gmail/callback
#   Render https://<서비스주소>/api/cs/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 인플루언서·파트너 (혁주·효선) ---
# 발송용 Gmail 주소와 앱 비밀번호 16자리 (예전 이름 gmail_address · gmail_api도 읽음)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# AI 프롬프트에 들어가는 제품 설명
PRODUCT_DESC=
# 선택 · 규제(검열) DB 주소 — 정해지면 협업 메일 화면에 "규제 DB 연결되었습니다" 표시
REGULATION_DB_URL=

# --- 콘텐츠 제작 (나원) ---
# 선택 · 대화·제작 텍스트 모델 (비우면 OPENAI_MODEL)
CONTENT_TEXT_MODEL=
# 선택 · 이미지 생성 모델 (비우면 gpt-image-1)
CONTENT_IMAGE_MODEL=
# 예정 · 영상 생성
HIGGSFIELD_API_KEY=
